{
	servers {
		# Tailscale Funnel connects from loopback and sets X-Forwarded-For to
		# the real client. Without this, Caddy discards that header and every
		# visitor reaches server.py as 127.0.0.1 (one shared rate-limit bucket).
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

http://:8000 {
	bind 127.0.0.1

	handle /api/* {
		request_body {
			max_size 950KB
		}
		reverse_proxy 127.0.0.1:8766
	}

	redir /hn /hn/

	handle_path /hn/* {
		request_body {
			max_size 950KB
		}
		reverse_proxy 127.0.0.1:8766
	}

	respond 404
}
