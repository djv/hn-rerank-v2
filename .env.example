# Copy to .env; never commit populated credentials.
# The server reads simple KEY=VALUE lines, optionally quoted (no shell expansion).
# Summary generation; ranking works without provider keys.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
# Optional providers: GROQ_API_KEY, GEMINI_API_KEY.

# These path variables must be in the process environment BEFORE Python starts,
# e.g. the systemd service EnvironmentFile; pipeline/config.py reads at import.
# HN_ONNX_MODEL_DIR=/absolute/path/to/mxbai-embed-xsmall-v1
# HN_SIDE_MODEL_DIR=/absolute/path/to/embeddinggemma-300m-onnx
# HN_ENV_FILE=/absolute/path/to/shared/.env
# TUI client default (export in the client shell, not only the server .env):
# HN_RERANK_SERVER=https://example.com/hn/
# HN_ENV_FILE is also used by scripts/backup_hn_db.sh for the secrets backup.
